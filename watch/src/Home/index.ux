<template>
  <!--
    `startoffset` is the list's own absolute scroll offset (documented for list, and the only control
    that survives a redraw which rebuilds the items). `onscroll` reports where the list is while the
    user drags it, which is when the offset has to be recorded - by the time a tap repaints the list it
    is already too late to ask. `onscrollindex` carries the visible index range, recorded alongside it
    for a runtime that reports the range but not the pixel offset.
  -->
  <list id="dashboard-list" class="page" startoffset="{{scrollOffset}}" onscroll="onScroll" onscrollindex="onScrollIndex">
    <list-item type="header" class="header">
      <text class="eyebrow">VITALITY · 活力记录</text>
      <text class="title">{{pageTitle}}</text>
      <div class="date-row" if="{{!pairMode}}">
        <input class="date-arrow" type="button" value="‹" onclick="previousDay" />
        <input class="date-value" type="button" value="{{dayText}}" onclick="dates" />
        <input class="date-arrow" type="button" value="›" onclick="nextDay" />
      </div>
      <text class="caption" if="{{!pairMode}}">{{savedText}}</text>
    </list-item>
    <list-item type="navigation" class="navigation" if="{{detail}}">
      <input class="back" type="button" value="{{backLabel}}" onclick="back" />
    </list-item>
    <list-item type="connection-info" class="card" if="{{pairMode}}">
      <text class="label">手机蓝牙直连</text>
      <text class="body">在手机搜索并点击这块手表即可连接，无需输入代码。</text>
      <text class="body">{{connectionText}}</text>
    </list-item>
    <list-item type="connection-actions" class="footer" if="{{pairMode}}">
      <text class="caption">切换手机前，先在旧手机关闭连接</text>
      <input class="back" type="button" value="清除旧手机连接" onclick="askClearPhone" if="{{!confirmDisconnect}}" />
      <text class="caption" if="{{confirmDisconnect}}">仅清除连接信息，健康记录保留</text>
      <input class="button" type="button" value="确认清除连接" onclick="clearPhone" if="{{confirmDisconnect}}" />
      <input class="settings-button" type="button" value="取消" onclick="cancelClearPhone" if="{{confirmDisconnect}}" />
    </list-item>
    <list-item for="{{card in items}}" type="{{card.scale ? 'body-scale' : 'record'}}" class="{{card.cardClass}}" onclick="select(card.action)">
      <text class="label">{{card.title}}</text>
      <text class="metric" if="{{card.highlight}}">{{card.body}}</text>
      <text class="body" if="{{!card.highlight}}">{{card.body}}</text>
      <div class="reference-scale" if="{{card.scale}}">
        <div class="scale-marker-row">
          <text class="scale-marker" if="{{card.scale.hasMarker}}" style="left: {{card.scale.markerLeft}}px;">▼</text>
        </div>
        <div class="scale-bar">
          <div for="{{band in card.scale.bands}}" class="scale-band" style="width: {{band.width}}px; background-color: {{band.color}};"></div>
        </div>
        <div class="scale-ticks">
          <text for="{{tick in card.scale.ticks}}" class="scale-tick" style="left: {{tick.left}}px;">{{tick.text}}</text>
        </div>
        <div class="scale-labels">
          <text for="{{label in card.scale.labels}}" class="scale-name" style="left: {{label.left}}px;">{{label.text}}</text>
        </div>
      </div>
      <text class="scale-note" if="{{card.scaleNote}}">{{card.scaleNote}}</text>
      <div class="balance" if="{{card.balance}}" style="background-color: {{card.balanceColor}};">
        <text class="balance-label">热量剩余</text>
        <text class="balance-value">{{card.balance}}</text>
      </div>
      <div class="choice-row" if="{{card.choices}}">
        <input class="{{card.left.cardClass}}" type="button" value="{{card.left.text}}" onclick="select(card.left.action)" />
        <input class="{{card.middle.cardClass}}" type="button" value="{{card.middle.text}}" onclick="select(card.middle.action)" />
        <input class="{{card.right.cardClass}}" type="button" value="{{card.right.text}}" onclick="select(card.right.action)" />
      </div>
      <div class="period-row" if="{{card.periodText}}">
        <input class="period-arrow" type="button" value="‹" onclick="select(card.previous)" />
        <input class="period-value" type="button" value="{{card.periodText}}" onclick="select(card.reset)" />
        <input class="period-arrow" type="button" value="›" onclick="select(card.next)" if="{{card.canNext}}" />
      </div>
      <div class="trend-marker-row" if="{{card.bars}}">
        <text class="trend-marker" if="{{card.marker}}" style="left: {{card.markerLeft}}px;">▼</text>
      </div>
      <div class="trend-plot" if="{{card.bars}}">
        <div class="trend-bar" for="{{bar in card.bars}}" style="margin-top: {{bar.top}}px; width: {{bar.width}}px; height: {{bar.height}}px; background-color: {{bar.color}};" onclick="select(bar.action)"></div>
      </div>
      <div class="trend-labels" if="{{card.bars}}">
        <text class="{{bar.labelClass}}" for="{{bar in card.bars}}" style="width: {{bar.width}}px;">{{bar.label}}</text>
      </div>
      <div class="trend-axis" if="{{card.bars}}">
        <text class="trend-axis-text">{{card.axisTop}}</text>
        <text class="trend-axis-text">{{card.axisBottom}}</text>
      </div>
      <text class="hint" if="{{card.hint}}">{{card.hint}}</text>
    </list-item>
    <list-item type="connection" class="footer" if="{{!detail}}">
      <text class="caption">{{connectionText}}</text>
      <input class="button" type="button" value="{{updateButton}}" onclick="refresh" />
      <input class="settings-button" type="button" value="连接管理" onclick="connection" />
      <text class="footnote">活力记录 1.0.0 · 蓝牙直连</text>
    </list-item>
  </list>
</template>

<script>
import dashboard from '../lib/dashboard.mjs'
import brightness from '@blueos.hardware.display.brightness'

function today() { const value = new Date(); return value.getFullYear() + '-' + ('0' + (value.getMonth() + 1)).slice(-2) + '-' + ('0' + value.getDate()).slice(-2) }
export default {
  data: { pageTitle: '今日总览', dayText: '', savedText: '', detail: false, pairMode: false, items: [],
    connectionText: '正在启动直连服务…', updateButton: '获取更新', backLabel: '‹ 返回总览',
    confirmDisconnect: false, scrollOffset: '' },
  staticData: { runtime: {} },
  onInit() {
    const link = this.$app.$def.getLinkRuntime()
    this.runtime.link = link
    this.runtime.day = today(); this.runtime.page = 'home'; this.runtime.visible = false
    this.runtime.loaded = false; this.runtime.busy = false; this.runtime.pending = false; this.runtime.connected = false
    this.runtime.dayGeneration = 0; this.runtime.screenTimer = null
    this.runtime.snapshot = null; this.runtime.savedAt = 0; this.runtime.archive = link.archive
    this.runtime.scrollY = 0; this.runtime.scrollIndex = 0
    this.runtime.savedCount = -1
    this.runtime.unsubscribe = link.subscribe(state => {
      this.runtime.loaded = state.ready; this.runtime.busy = state.busy; this.runtime.pending = state.pending
      this.runtime.connected = state.connected
      this.connectionText = state.message
      this.updateButton = state.busy ? '正在更新…' : state.pending ? '等待手机更新…' : '获取更新'
      if (this.runtime.visible) {
        if ((state.busy || state.pending) && !this.runtime.screenTimer) this.holdScreen()
        else if (!state.busy && !state.pending && state.connected) this.releaseScreen()
        if (state.ready && this.runtime.savedCount !== state.saved) this.loadDay()
      }
      this.runtime.savedCount = state.saved
    })
    this.updateDisplay(); link.start().then(() => { if (this.runtime.loaded) this.loadDay() })
  },
  onReady() {
    this.runtime.visible = true; if (this.runtime.loaded) this.loadDay()
    if (!this.runtime.connected || this.runtime.busy || this.runtime.pending) this.holdScreen()
    this.runtime.link.ensureServer()
  },
  onShow() {
    this.runtime.visible = true; if (this.runtime.loaded) this.loadDay()
    this.updateDisplay()
    if (!this.runtime.connected || this.runtime.busy || this.runtime.pending) this.holdScreen()
    this.runtime.link.ensureServer()
  },
  onHide() { this.runtime.visible = false; this.releaseScreen() },
  onDestroy() {
    this.runtime.visible = false; this.runtime.dayGeneration++
    if (this.runtime.unsubscribe) this.runtime.unsubscribe()
    this.runtime.unsubscribe = null; this.releaseScreen()
    // The application, rather than a page, owns the BLE server.
  },
  onBackPress() { if (this.runtime.page !== 'home') { this.back(); return true }; return false },
  async loadDay() {
    const generation = ++this.runtime.dayGeneration; const day = this.runtime.day
    try {
      const snapshot = await this.runtime.archive.read(day)
      if (generation !== this.runtime.dayGeneration) return
      this.runtime.snapshot = snapshot; this.runtime.savedAt = this.runtime.archive.savedAt(day); this.updateDisplay()
    } catch (_) {
      if (generation === this.runtime.dayGeneration) {
        this.runtime.snapshot = null; this.runtime.savedAt = 0; this.updateDisplay()
        this.connectionText = '该日缓存不可读，请获取更新'
      }
    }
  },
  shiftDay(offset) {
    const parts = this.runtime.day.split('-'); const value = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]) + offset)
    const next = value.getFullYear() + '-' + ('0' + (value.getMonth() + 1)).slice(-2) + '-' + ('0' + value.getDate()).slice(-2)
    if (next > today()) return
    this.runtime.day = next; this.loadDay()
  },
  previousDay() { this.shiftDay(-1) }, nextDay() { this.shiftDay(1) }, dates() { this.select('dates') },
  back() { this.select(this.runtime.page.indexOf('meal:') === 0 ? 'meals' : 'home') },
  connection() { this.confirmDisconnect = false; this.select('connection') },
  select(page) {
    if (!page) return
    if (page.indexOf('day:') === 0) { this.runtime.day = page.slice(4); this.runtime.page = 'home'; this.restoreScroll(false); this.loadDay(); return }
    // The trend pages carry their own state in their name (series, scale, how many periods back, which
    // column was tapped), so the router asks the dashboard rather than keeping a list that cannot know
    // about tomorrow's scale.
    if (['home', 'connection', 'energy', 'exercise', 'meals', 'advice', 'dates',
      'meal:breakfast', 'meal:lunch', 'meal:dinner', 'meal:snack'].indexOf(page) < 0 && !dashboard.parse(page)) return
    if (page !== 'connection') this.confirmDisconnect = false
    // A series tab, a scale chip, a period step and a column tap all redraw the card the user is
    // already standing on. Only a real move starts at the top.
    const keep = dashboard.sameChart(this.runtime.page, page)
    this.runtime.page = page; this.updateDisplay(); this.restoreScroll(keep)
  },
  /**
   * A second line of defence for a redraw that only changes the chart card the user is already in.
   *
   * The fix for the jump is the fixed row set the dashboard builds: the list resets its scroll offset
   * when its items are inserted or deleted, so a page whose rows never change shape never resets. This
   * runs only for the cases that can still move items (a sync landing while the chart is open, or a
   * runtime that relayouts differently).
   *
   * Both controls are applied, because a path the runtime ignores fails silently: the item index is
   * the one the list is known to accept (`scrollTo`), and `startoffset` is the exact pixel offset for
   * a runtime that honours a bound attribute. With the row set fixed, an index recorded before the
   * switch names the same row after it.
   */
  restoreScroll(keep) {
    if (!keep) {
      this.runtime.scrollY = 0; this.runtime.scrollIndex = 0
      this.scrollOffset = ''
      try { this.$element('dashboard-list').scrollTo({ index: 0 }) } catch (_) {}
      return
    }
    this.scrollOffset = this.runtime.scrollY > 0 ? String(this.runtime.scrollY) : ''
    if (this.runtime.scrollIndex > 0) {
      try { this.$element('dashboard-list').scrollTo({ index: this.runtime.scrollIndex, behavior: 'instant' }) } catch (_) {}
    }
  },
  /** Where the list is while the user drags it, so a redraw has somewhere to return to. */
  onScroll(event) {
    const value = event && typeof event.scrollY === 'number' ? event.scrollY : null
    if (value === null || !(value >= 0)) return
    this.runtime.scrollY = value
  },
  /** The visible index range, for the runtimes that report a range rather than a pixel offset. */
  onScrollIndex(event) {
    const value = event && typeof event.first === 'number' ? event.first : null
    if (value === null || !(value >= 0)) return
    this.runtime.scrollIndex = value
  },
  updateDisplay() {
    const titles = { home: '每日总览', connection: '连接管理', energy: '每日能量参考', exercise: '运动记录',
      meals: '三餐', advice: 'AI 建议', dates: '选择日期',
      'meal:breakfast': '早餐', 'meal:lunch': '午餐', 'meal:dinner': '晚餐', 'meal:snack': '加餐' }
    this.pageTitle = titles[this.runtime.page] || dashboard.title(this.runtime.page)
    this.detail = this.runtime.page !== 'home'; this.pairMode = this.runtime.page === 'connection'
    this.backLabel = this.runtime.page.indexOf('meal:') === 0 ? '‹ 返回三餐' : '‹ 返回总览'
    this.dayText = this.runtime.day + (this.runtime.day === today() ? ' · 今天' : '')
    this.savedText = this.runtime.savedAt ? '保存于 ' + dashboard.time(this.runtime.savedAt) : '该日暂无已同步记录'
    if (this.pairMode) this.items = []
    else if (this.runtime.page === 'dates') this.items = this.runtime.archive.dates().map(day => ({ title: day, body: '查看这一天', action: 'day:' + day, highlight: false, cardClass: 'card', hint: '点击查看 ›' }))
    // The series belongs to the app, not to the day on screen: the archive keeps the last one the phone
    // sent, so viewing the 12th still draws the 14th's reading.
    else this.items = dashboard.rows(this.runtime.snapshot, this.runtime.page, this.runtime.archive.history())
  },
  askClearPhone() { this.confirmDisconnect = true },
  cancelClearPhone() { this.confirmDisconnect = false },
  async clearPhone() {
    try { await this.runtime.link.clearPhone(); this.confirmDisconnect = false }
    catch (error) { this.connectionText = error.message || '连接清除失败，请稍后重试' }
  },
  async refresh() {
    if (!this.runtime.visible || this.runtime.busy) return
    try { await this.runtime.link.requestUpdate(); this.holdScreen() }
    catch (error) { this.connectionText = error.message || '更新请求未保存，请重试' }
  },
  holdScreen() {
    this.releaseScreen(); try { brightness.setKeepScreenOn({ keepScreenOn: true }) } catch (_) {}
    this.runtime.screenTimer = setTimeout(() => this.releaseScreen(), 150000)
  },
  releaseScreen() {
    if (this.runtime.screenTimer) clearTimeout(this.runtime.screenTimer); this.runtime.screenTimer = null
    try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (_) {}
  }
}
</script>

<style>
.page { width: 432px; height: 100%; background-color: #111018; }
.header { width: 396px; flex-direction: column; align-items: center; margin: 0px 18px; padding: 22px 0px 10px; }
.eyebrow { width: 396px; text-align: center; font-size: 17px; color: #BFAEFF; }
.title { width: 396px; text-align: center; font-size: 34px; color: #FFFFFF; font-weight: bold; margin-top: 8px; }
.caption { width: 360px; text-align: center; font-size: 19px; color: #B9B3CA; margin-top: 8px; }
.date-row { width: 396px; margin-top: 12px; flex-direction: row; align-items: center; justify-content: center; }
.date-arrow { width: 46px; height: 50px; background-color: #252032; color: #D6C9FF; border-radius: 16px; font-size: 28px; }
.date-value { width: 296px; height: 50px; margin: 0px 4px; background-color: #211D2E; color: #D6C9FF; border-radius: 16px; font-size: 20px; }
.navigation { width: 396px; margin: 4px 18px; justify-content: center; }
.back { width: 396px; height: 54px; background-color: #252032; border-radius: 18px; color: #D6C9FF; font-size: 22px; }
.card { width: 396px; flex-direction: column; align-items: center; padding: 18px; margin: 6px 18px; border-radius: 24px; background-color: #211D2E; }
.label { width: 360px; text-align: center; font-size: 22px; color: #D4CADE; }
.metric { width: 360px; text-align: center; font-size: 29px; line-height: 38px; color: #CCB8FF; margin-top: 10px; font-weight: bold; }
.body { width: 360px; text-align: center; font-size: 22px; line-height: 32px; color: #F0EBF8; margin-top: 10px; }
.balance { width: 360px; flex-direction: column; align-items: center; padding: 14px; margin-top: 14px; border-radius: 18px; }
.balance-label { width: 332px; text-align: center; font-size: 19px; color: #FFFFFF; }
.balance-value { width: 332px; text-align: center; font-size: 30px; color: #FFFFFF; font-weight: bold; margin-top: 6px; }
.hint { width: 360px; text-align: center; font-size: 18px; color: #A99ABC; margin-top: 12px; }
.footer { width: 396px; flex-direction: column; align-items: center; margin: 8px 18px 24px; padding: 10px 0px; }
.button { width: 396px; height: 64px; background-color: #7955D8; color: #FFFFFF; border-radius: 22px; font-size: 24px; margin-top: 14px; }
.footnote { width: 396px; text-align: center; font-size: 17px; color: #8F879F; margin-top: 16px; }
.reference-scale { width: 300px; height: 96px; flex-direction: column; margin-top: 8px; }
.scale-marker-row { width: 300px; height: 24px; position: relative; }
.scale-marker { position: absolute; width: 20px; height: 24px; font-size: 18px; text-align: center; color: #CCB8FF; }
.scale-bar { width: 300px; height: 14px; flex-direction: row; }
.scale-band { height: 14px; }
.scale-ticks { width: 300px; height: 24px; position: relative; margin-top: 5px; }
.scale-tick { position: absolute; width: 44px; font-size: 14px; text-align: center; color: #B9B3CA; }
.scale-labels { width: 300px; height: 26px; position: relative; }
.scale-name { position: absolute; width: 60px; font-size: 15px; text-align: center; color: #D4CADE; }
.scale-note { width: 300px; font-size: 18px; line-height: 26px; text-align: center; color: #B9B3CA; margin-top: 10px; }
.settings-button { width: 360px; height: 56px; margin-top: 12px; border-radius: 18px; background-color: #252032; color: #D6C9FF; font-size: 22px; }
.trend-plot { width: 360px; height: 120px; flex-direction: row; align-items: flex-start; justify-content: center; margin-top: 16px; }
.trend-bar { margin-left: 4px; border-radius: 3px; }
.trend-labels { width: 360px; flex-direction: row; justify-content: center; margin-top: 6px; }
.trend-label { margin-left: 4px; text-align: center; font-size: 15px; color: #8F879F; }
.trend-label-on { color: #F2C14E; font-weight: bold; }
.trend-marker-row { width: 360px; height: 22px; position: relative; margin-top: 12px; }
.trend-marker { position: absolute; width: 20px; height: 22px; font-size: 16px; text-align: center; color: #F2C14E; }
.trend-axis { width: 360px; flex-direction: row; justify-content: space-between; margin-top: 8px; }
.trend-axis-text { font-size: 16px; color: #B9B3CA; }
.choice-row { width: 360px; flex-direction: row; justify-content: center; margin-top: 14px; }
.choice { width: 108px; height: 48px; margin: 0px 4px; border-radius: 14px; background-color: #252032; color: #D6C9FF; font-size: 20px; }
.choice-on { background-color: #7955D8; color: #FFFFFF; font-weight: bold; }
.period-row { width: 360px; flex-direction: row; align-items: center; justify-content: center; margin-top: 12px; }
.period-arrow { width: 44px; height: 46px; background-color: #252032; color: #D6C9FF; border-radius: 16px; font-size: 26px; }
.period-value { width: 262px; height: 46px; margin: 0px 4px; background-color: #211D2E; color: #D6C9FF; border-radius: 16px; font-size: 20px; }
.tab-off { width: 396px; flex-direction: column; align-items: center; padding: 14px; margin: 4px 18px; border-radius: 20px; background-color: #252032; }
.tab-on { width: 396px; flex-direction: column; align-items: center; padding: 14px; margin: 4px 18px; border-radius: 20px; background-color: #7955D8; }
</style>
